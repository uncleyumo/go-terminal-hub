# Normalize line endings: LF in the repository, LF in the working tree.
# .gitattributes takes precedence over core.autocrlf, so this makes the
# behavior identical for every contributor and platform.
* text=auto eol=lf

# Windows batch files must keep CRLF or cmd.exe misparses them.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.car binary
*.ttf binary
*.woff binary
*.woff2 binary
*.jar binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
